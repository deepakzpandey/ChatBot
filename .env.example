# ==============================================================================
# IPC Legal Assistant - Multi-Provider AI Configuration
# ==============================================================================
# Switch providers anytime by changing AI_PROVIDER and AI_API_KEY below.
# Supported providers: gemini | groq | openrouter

# 1. Active Provider Selection ('gemini', 'groq', or 'openrouter')
AI_PROVIDER=gemini

# 2. API Key for the selected provider
AI_API_KEY=your_api_key_here

# Examples:
# For Groq:
# AI_PROVIDER=groq
# AI_API_KEY=gsk_...
# AI_MODEL=qwen/qwen3.8-27b

# 3. (Optional) Custom Model Override
# Leave empty to use the provider's default model:
# - Gemini default:     gemini-2.5-flash
# - Groq default:       qwen/qwen3.8-27b (or openai/gpt-oss-120b)
# - OpenRouter default: meta-llama/llama-3.3-70b-instruct:free
AI_MODEL=

# ------------------------------------------------------------------------------
# Provider Key Fallbacks (Optional alternative to AI_API_KEY):
# GEMINI_API_KEY=your_gemini_key_here          # https://aistudio.google.com/
# GROQ_API_KEY=your_groq_key_here              # https://console.groq.com/
# OPENROUTER_API_KEY=your_openrouter_key_here  # https://openrouter.ai/
# ------------------------------------------------------------------------------
